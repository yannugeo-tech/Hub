function loadMainHub()
   local MainWindow = Rayfield:CreateWindow({
      Name = "⚡ Neihub [모바일 전용 프리미엄 허브]",
      LoadingTitle = "Hub Initializing...",
      LoadingSubtitle = "24시간 인증 활성화됨",
      ConfigurationSaving = { Enabled = true, FolderName = "NeihubHub", FileName = "MainConfig" },
      Discord = { Enabled = false },
      KeySystem = false
   })

   local Camera = workspace.CurrentCamera
   local RunService = game:GetService("RunService")
   local UserInputService = game:GetService("UserInputService")

   -- 1. Ragebot 탭
   local RageTab = MainWindow:CreateTab("Ragebot", 4483362458)
   RageTab:CreateSection("타겟 머리 추적 및 TP")
   
   local headTPActive = false
   RageTab:CreateToggle({
      Name = "상대 머리로 TP 후 공격",
      CurrentValue = false,
      Callback = function(Value)
         headTPActive = Value
      end,
   })

   RunService.Heartbeat:Connect(function()
      if headTPActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
         local closest = nil
         local shortest = math.huge
         for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
               local dist = (LocalPlayer.Character.HumanoidRootPart.Position - p.Character.Head.Position).Magnitude
               if dist < shortest then shortest = dist closest = p end
            end
         end
         if closest and closest.Character and closest.Character:FindFirstChild("Head") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = closest.Character.Head.CFrame * CFrame.new(0, 2, 0)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Character.Head.Position)
         end
      end
   end)

   -- 2. Main 탭 (10가지 기능)
   local MainTab = MainWindow:CreateTab("Main (10가지)", 4483362458)
   MainTab:CreateSection("주요 전투 및 보조 기능")
   
   local features = {
      "1. 에임봇 (Aimbot)", "2. 무소음 에임 (Silent Aim)", "3. 자동 발사 (Triggerbot)", 
      "4. 벽 투시 (Wallhack)", "5. 적 위치 선 표시 (ESP Lines)", "6. 반동 제어 (No Recoil)", 
      "7. 무한 탄창 (Infinite Ammo)", "8. 연속 자동 사격 (Auto Shoot)", "9. 연사 속도 증가 (Rapid Fire)", "10. 시야각 조절 (FOV)"
   }

   for _, featName in ipairs(features) do
      MainTab:CreateToggle({
         Name = featName,
         CurrentValue = false,
         Callback = function(Value)
            -- 기능별 로직 구현 공간
         end,
      })
   end

   -- 3. 스크립트 조회 탭
   local ScriptTab = MainWindow:CreateTab("스크립트 조회", 4483362458)
   ScriptTab:CreateSection("클라우드 스크립트 저장소")

   ScriptTab:CreateButton({
      Name = "추가 스크립트 A 조회 및 실행",
      Callback = function()
         Rayfield:Notify({Title = "조회 완료", Content = "추가 스크립트 A가 정상적으로 로드되었습니다.", Duration = 3})
      end,
   })

   ScriptTab:CreateButton({
      Name = "추가 스크립트 B 조회 및 실행",
      Callback = function()
         Rayfield:Notify({Title = "조회 완료", Content = "추가 스크립트 B가 정상적으로 로드되었습니다.", Duration = 3})
      end,
   })

   Rayfield:Notify({Title = "Neihub", Content = "24시간 동안 인증이 유지됩니다. 모든 기능 활성화 완료!", Duration = 4})
end
