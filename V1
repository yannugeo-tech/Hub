-- Rayfield 라이브러리 로드
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 24시간 인증 기록 파일 경로
local AuthFile = "Neihub_24Hours_Auth.json"

-- 24시간 유효성 검사 함수
local function checkAuthValid()
   if readfile and isfile and isfile(AuthFile) then
      local success, data = pcall(function()
         return HttpService:JSONDecode(readfile(AuthFile))
      end)
      if success and data and data.ExpireTime then
         -- 현재 시간이 만료 시간보다 앞서있다면 (24시간 지나지 않음) true 반환
         if os.time() < data.ExpireTime then
            return true
         end
      end
   end
   return false
end

-- 24시간 만료 시간 저장 함수
local function saveAuthTime()
   if writefile then
      local data = {
         ExpireTime = os.time() + (24 * 60 * 60) -- 현재 시간 + 24시간(초)
      }
      writefile(AuthFile, HttpService:JSONEncode(data))
   end
end

